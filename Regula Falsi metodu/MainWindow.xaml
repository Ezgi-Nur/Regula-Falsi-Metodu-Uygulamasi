<Window x:Class="Regula_falsi_metodu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Regula_falsi_metodu"
        mc:Ignorable="d"
        Title="Uygulama" Height="450" Width="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="0,0,800,434">
        <Grid x:Name="grid1" RenderTransformOrigin="0.5,0.5" Margin="0,0,-800,-433">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.045"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Content="Aralık" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Margin="66,59,0,0"/>
            <TextBox x:Name="txtInterval1" HorizontalAlignment="Left" Margin="210,63,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="90" FontSize="20" RenderTransformOrigin="0.5,0.5"/>
            <TextBox x:Name="txtInterval2" HorizontalAlignment="Left" Margin="324,63,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="90" FontSize="20" RenderTransformOrigin="0.665,0.536"/>
            <Label Content="," HorizontalAlignment="Left" Margin="305,59,0,0" VerticalAlignment="Top" FontSize="20"/>
            <Label Content="Doğruluk" HorizontalAlignment="Left" Margin="65,130,0,0" VerticalAlignment="Top" FontSize="20"/>
            <Label Content="10^-" HorizontalAlignment="Left" Margin="210,130,0,0" VerticalAlignment="Top" FontSize="20"/>
            <ComboBox x:Name="cmbAccuracy" HorizontalAlignment="Left" Margin="268,141,0,0" VerticalAlignment="Top" Width="33" Height="20" RenderTransformOrigin="0.525,0.529"/>
            <Label Content="Fonksiyon" HorizontalAlignment="Left" Margin="65,192,0,0" VerticalAlignment="Top" FontSize="20" Height="41"/>
            <TextBox x:Name="txtFunc" HorizontalAlignment="Left" Margin="268,198,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="432" FontSize="20" RenderTransformOrigin="0.665,0.536"/>
            <Label Content="Ör: cos(x)-x*e^x" HorizontalAlignment="Left" Margin="65,232,0,0" VerticalAlignment="Top" FontSize="16" Height="34" IsEnabled="False"/>
            <Button x:Name="btnHesapla" Content="Hesapla" HorizontalAlignment="Left" Margin="605,286,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="20" Width="152" Height="42" Click="btnHesapla_Click"/>
            <Label Content="f(x) =" HorizontalAlignment="Left" Margin="206,192,0,0" VerticalAlignment="Top" FontSize="20" Height="41"/>
            <Label Content="= 0" HorizontalAlignment="Left" Margin="701,192,0,0" VerticalAlignment="Top" FontSize="20" Height="41"/>
            <Label Content="Ondalıklı kısmı ayırırken '.' yerine ',' kullanınız" HorizontalAlignment="Left" Margin="63,93,0,0" VerticalAlignment="Top" FontSize="16" Height="34" IsEnabled="False"/>

        </Grid>
        <Grid x:Name="gridStep" Margin="0,0,-798,-432" d:IsHidden="True">
            <ScrollViewer x:Name="ScrollViewerIteration" Margin="0,0,0,60" HorizontalScrollBarVisibility="Auto" 
                >
                <StackPanel x:Name="StackPanelIteration" />
            </ScrollViewer>
            <Button x:Name="btnGraph" Content="Grafiği göster" Margin="297,377,297,20" FontSize="20" Background="#FFF4F4F4" VerticalAlignment="Top" Click="btnGraph_Click"/>
            <Button x:Name="btnRestart" Content="Yeni hesaplama" Margin="520,377,74,20" FontSize="20" Background="#FFF4F4F4" VerticalAlignment="Top" Click="btnRestart_Click"/>
            <Grid x:Name="gridGraph" Margin="0,0,0,60" IsEnabled="False" Visibility="Hidden">
                <WpfPlot x:Name="WpfPlot1"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
